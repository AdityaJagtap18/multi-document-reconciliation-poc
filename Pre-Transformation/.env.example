# Copy to .env and fill in. .env is git-ignored; this file is not.
#
#   cp .env.example .env
#
# mock  = synthetic Query Fields responses, offline, free, deterministic  (default)
# azure = 32 rendered PDFs through a real Document Intelligence resource
#
# Run mock first. It is the lab. Run azure afterwards to find out how much of
# what you concluded survives contact with the service.
#
# THIS IS THE SAME RESOURCE AND THE SAME VARIABLES AS DAY 14. If you already
# have a Day 14 .env, copy it here unchanged and this lab runs.
DOCINT_PROVIDER=mock

# --------------------------------------------------------------------------
# Azure AI Document Intelligence  (only read when DOCINT_PROVIDER=azure)
# --------------------------------------------------------------------------
# The resource endpoint, from Portal > your Document Intelligence (or Azure AI
# Services) resource > Keys and Endpoint. Include the scheme, trailing slash
# optional.
AZURE_DOCINT_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DOCINT_KEY=<your-key>

# Query Fields is an add-on to prebuilt-layout. run_lab adds both halves of it
# for you — features=queryFields AND the queryFields= list — because sending
# the names without the feature flag returns HTTP 200 and no fields at all.
AZURE_DOCINT_MODEL=prebuilt-layout
AZURE_DOCINT_API_VERSION=2024-11-30

# auto = derive the URL path from the api-version:
#          2024-11-30 and later  ->  /documentintelligence/
#          anything earlier      ->  /formrecognizer/
# Force it only when you are debugging a 404 — which is what a route mismatch
# looks like, even though the error message talks about the model.
AZURE_DOCINT_ROUTE=auto

# Seconds to wait for ONE document to finish analysing.
AZURE_DOCINT_TIMEOUT=180

# Seconds between polls of the whole batch. The orchestrator polls every job
# once, waits this long, then polls them all again. Too small and you spend the
# run being rate-limited; too large and a fast document sits finished, waiting.
AZURE_DOCINT_POLL_GAP=1.5

# Seconds between SUBMISSIONS. Leave at 0 unless a free-tier resource is
# rejecting the burst of 32 POSTs with 429s faster than the backoff recovers.
AZURE_DOCINT_SUBMIT_GAP=0

# Raw service responses are cached under out/azure/di_raw/ so re-running the
# three strategies over real data costs nothing. The stitching is
# deterministic; the extraction is the part you pay for. Set false to force a
# fresh read of all 32 documents every run.
DOCINT_USE_CACHE=true

# A guard against pointing this at a folder of 4,000 documents by accident.
# This lab needs 32.
DOCINT_MAX_DOCUMENTS=60
